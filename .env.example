# Copy to .env and fill in the values: cp .env.example .env
# NEXT_PUBLIC_* variables are embedded into the JavaScript at build time (`next build`),
# so they are public: never put secrets in NEXT_PUBLIC_ variables.
# Declare every variable in src/types/env.ts to get it typed.

NEXT_PUBLIC_API_URL=
# public URL of the app without a trailing slash, e.g. https://example.com; defaults to http://localhost:3000
NEXT_PUBLIC_APP_URL=
# deployment environment, e.g. staging; defaults to NODE_ENV (development / production).
# Only `production` is indexed by search engines (robots.txt).
NEXT_PUBLIC_APP_ENV=

# Sentry error tracking, disabled when NEXT_PUBLIC_SENTRY_DSN is empty
NEXT_PUBLIC_SENTRY_DSN=
