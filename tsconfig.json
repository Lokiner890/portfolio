{
  // Managed together with Next.js: `next build` / `next typegen` add the options Next.js needs
  // (e.g. allowJs, esModuleInterop, plugins, include) and rewrite the file in this format.
  // https://nextjs.org/docs/app/api-reference/config/typescript
  "compilerOptions": {
    // TypeScript only type-checks (noEmit), Next.js (SWC) compiles. target/lib set which syntax and
    // built-in APIs can be used, Next.js supports Chrome 111+, Firefox 111+, Safari 16.4+.
    // DOM includes DOM.Iterable since TypeScript 6.
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    // global types: `types` is [] by default since TypeScript 6; node for process.env,
    // vitest/globals and jest-dom matchers for the tests
    "types": [
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // suggested by Next.js (re-added when missing): .ts files can import .js files
    "allowJs": true,
    // required by Next.js (SWC), can't be false since TypeScript 6
    "esModuleInterop": true,
    // speeds up repeated type checks (tsconfig.tsbuildinfo, gitignored)
    "incremental": true,
    // editor support for Next.js specific types and checks
    "plugins": [
      {
        "name": "next"
      }
    ],
    /* Linting */
    // default since TypeScript 6, kept explicit
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    // default since TypeScript 6, kept explicit
    "noUncheckedSideEffectImports": true,
    /* Paths */
    // relative to this file, `baseUrl` is not needed (deprecated in TypeScript 6)
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  // .next/types: route types generated by `next typegen` / `next dev` / `next build`
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
